params {
    regulon_net = "collectri" // can bei either "collectri" or "dorothea"
    outdir = "data/results"
    // whether to run the single-cell clustering or use the precomputed values instead.
    // The clustering is not fully reproducible on all systems and may lead to cell-type labels being mixed up
    // breaking all downstream analyses.
    run_clustering = false
    precomputed_adata_annotated = "data/results/20_single_cell/22_annotate_myeloid/artifacts"
    // flag to include tracerx data in the results directory
    // unfortunately, tracerx data must not be published - this flag activates a pipeline run that excludes this data.
    include_tracerx = false
    bulk_input_dir = "data/01_processed/${ params.include_tracerx ? "bulk_rna_seq" : "bulk_rna_seq_no_tracerx" }"
    publish_dir_mode = "link"
    // enable_conda = false
    singularity_pull_docker_container = false
    max_cpus = 16
    max_memory = '80.GB'

    modules {
        "P12_prepare_mofa_data" {
            publish_dir = "${ params.include_tracerx ? '10_mofa' : '10_mofa_no_tracerx' }/12_prepare_mofa_data"
        }
        "P14_mofa_analysis" {
            publish_dir = "${ params.include_tracerx ? '10_mofa' : '10_mofa_no_tracerx' }/14_mofa_analysis"
        }
        "P15_iHet_predictions" {
            publish_dir = "${ params.include_tracerx ? '10_mofa' : '10_mofa_no_tracerx' }/15_ihet_predictions"
        }
    }
}

process {
    // containerOptions = "--no-home --writable-tmpfs"
    containerOptions = "--no-home -B \$(mkdir .cache; pwd)/.cache:\$HOME/.cache -B \$(mkdir .config; pwd)/.config:\$HOME/.config -B \$(mkdir .mamba; pwd)/.mamba:\$HOME/.mamba -B \$(pwd):\$HOME/tmp"
    withName: P11_easier {
        container = "containers/2021-nsclc_heterogeneity_r3-2024-05-29.sif"
        // conda = "/home/sturm/apps/micromamba/envs/2021-nsclc_heterogeneity_r"
        time = '1d'
        cpus = check_max(2, 'cpus')
        memory = check_max(10.GB, 'memory')
        publishDir = [ path: { "${params.outdir}/${ params.include_tracerx ? '10_mofa' : '10_mofa_no_tracerx' }/${ meta.id }" }, mode: params.publish_dir_mode ]
        ext.regulon_net = { "${params.regulon_net}" }
    }
    withName: P12_prepare_mofa_data {
        memory = check_max(40.GB, 'memory')
        container = "containers/2021-nsclc_heterogeneity_r3-2024-05-29.sif"
        // conda = "/home/sturm/apps/micromamba/envs/2021-nsclc_heterogeneity_r"
    }
    withName: P13_run_mofa {
        container = "containers/2021-nsclc_heterogeneity_r3-2024-05-29.sif"
        // conda = "/home/sturm/apps/micromamba/envs/2021-nsclc_heterogeneity_r"
        memory = check_max(4.GB, 'memory')
        publishDir = [ path: { "${params.outdir}/${ params.include_tracerx ? '10_mofa' : '10_mofa_no_tracerx' }/${ meta.id }" }, mode: params.publish_dir_mode ]
    }
    withName: P14_mofa_analysis {
        memory = check_max(40.GB, 'memory')
        // conda = "/home/sturm/apps/micromamba/envs/2021-nsclc_heterogeneity_r"
        container = "containers/2021-nsclc_heterogeneity_r3-2024-05-29.sif"
    }
    withName: P15_iHet_predictions {
        memory = check_max(40.GB, 'memory')
        // conda = "/home/sturm/apps/micromamba/envs/2021-nsclc_heterogeneity_r"
        container = "containers/2021-nsclc_heterogeneity_r3-2024-05-29.sif"
        // container = null
    }

    withName: "W20_single_cell:JUPYTER.*" {
        ext.kernel = "python3"
        publishDir = [ path: { "${params.outdir}/20_single_cell/${meta.id}/" }, mode: params.publish_dir_mode ]
        container = "containers/2021-nsclc-heterogeneity-scanpy3.sif"
        memory = check_max(80.GB, 'memory')
    }
    withName: "JUPYTER_SUBSET_ATLAS|JUPYTER_ANNOTATE_MYELOID|JUPYTER_TF_PW" {
        cpus = check_max(8, 'cpus')
    }

    withName: "W30_spatial:JUPYTER.*" {
        memory = check_max(20.GB, 'memory')
        ext.kernel = "python3"
        publishDir = [ path: { "${params.outdir}/30_spatial/${meta.id}/" }, mode: params.publish_dir_mode ]
        container = "containers/2021-nsclc-heterogeneity-scanpy3.sif"
    }
}

singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions = "--env MKL_NUM_THREADS=1,OPENBLAS_NUM_THREADS=1,OMP_NUM_THREADS=1"
resume = true
// conda.useMicromamba  = true
// process.executor = 'slurm'


// Function to ensure that resource requirements don't go beyond
// a maximum limit
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}
